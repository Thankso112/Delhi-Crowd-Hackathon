# Copy this file to ".env" (same folder) and put your own MySQL details.
# The ".env" file is ignored by git, so your password is never uploaded to GitHub.
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
# USE_MYSQL=1             # uncomment to store results in MySQL instead of the default local SQLite file
